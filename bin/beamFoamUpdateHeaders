#!/bin/bash
#------------------------------------------------------------------------------
# License
#     This file is part of beamFoam, licensed under the GNU General Public
#     License <http://www.gnu.org/licenses/>.
#
# Script
#     beamFoamUpdateHeaders
#     adapted from solids4FoamChangeCopyright and
#     solids4FoamUpdateCaseFileHeader in solids4foam
#
# Description
#     Updates the header of beamFoam files to the solids4foam layout:
#       - .C and .H files: everything above the end of the License block
#         (the OpenFOAM or foam-extend banner and copyright lines) becomes
#         the beamFoam License block. Class, Description, etc. are kept.
#         Files that do not start with a comment (#include-d code fragments)
#         are skipped
#       - OpenFOAM dictionaries: the banner above FoamFile
#     Other files, scripts included, are skipped.
#
#     Update all files:
#
#     $ git ls-files -z | xargs -0 bin/beamFoamUpdateHeaders
#
#     Only report files with an outdated header (exits 1 if there are any):
#
#     $ git ls-files -z | xargs -0 bin/beamFoamUpdateHeaders -check
#
#------------------------------------------------------------------------------

usage()
{
    exec 1>&2
    while [ "$#" -ge 1 ]; do echo "$1"; shift; done
    cat<<USAGE

Usage: ${0##*/} [OPTION] <file1> ... <fileN>

options:
  -check              report files with an outdated header, do not modify
  -help               print the usage

USAGE
    exit 1
}

checkOnly=false

while [ "$#" -gt 0 ]
do
    case "$1" in
    -check)
        checkOnly=true
        ;;
    -h | -help)
        usage
        ;;
    --)
        shift
        break
        ;;
    -*)
        usage "unknown option: '$1'"
        ;;
    *)
        break
        ;;
    esac
    shift
done

[ "$#" -ge 1 ] || usage "No files specified"


# * * * * * * * * * * * * * * * * Headers  * * * * * * * * * * * * * * * * * //

export sourceHeader='/*---------------------------------------------------------------------------*\
License
    This file is part of beamFoam.

    beamFoam is free software: you can redistribute it and/or modify it
    under the terms of the GNU General Public License as published by the
    Free Software Foundation, either version 3 of the License, or (at your
    option) any later version.

    beamFoam is distributed in the hope that it will be useful, but
    WITHOUT ANY WARRANTY; without even the implied warranty of
    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
    General Public License for more details.

    You should have received a copy of the GNU General Public License
    along with beamFoam.  If not, see <http://www.gnu.org/licenses/>.

'

export dictHeader='/*--------------------------------*- C++ -*----------------------------------*\
| beamFoam: finite volume solver for geometrically exact beams                |
| Web:         https://github.com/solids4foam/beamFoam                        |
| Disclaimer:  This offering is not approved or endorsed by OpenCFD Limited,  |
|              producer and distributor of the OpenFOAM software via          |
|              www.openfoam.com, and owner of the OPENFOAM® and OpenCFD®      |
|              trade marks.                                                   |
\*---------------------------------------------------------------------------*/
'


# * * * * * * * * * * * * * * * * Functions  * * * * * * * * * * * * * * * * //

# Write the file $1 with an updated header to stdout.
# Returns 3 if the file does not start with a comment (no header to update),
# and 2 if it does but has no License block.
updateSource()
{
    perl -0777 -ne '
        exit 3 unless /\A\s*\/\*/;

        # Everything up to the end of the License block (its indented and
        # blank lines) is replaced
        s{\A\s*/\*-[^\n]*\n.*?^License\n(?:(?:[ \t][^\n]*)?\n)*}
         {$ENV{sourceHeader}}ms
            or exit 2;
        print;
    ' "$1"
}

updateDict()
{
    perl -0777 -ne '
        s{\A(?:/\*[^\n]*\n(?:[^\n]*\n)*?\\\*-+\*/\n)?\s*(?=FoamFile\b)}
         {$ENV{dictHeader}}s
            or exit 2;
        print;
    ' "$1"
}


# * * * * * * * * * * * * * * * * * * Main * * * * * * * * * * * * * * * * * //

tmpFile="$(mktemp)" || exit 1
trap 'rm -f "$tmpFile"' EXIT

nChecked=0
nOutdated=0
nFailed=0

for file
do
    [ -f "$file" ] || continue

    case "$file" in
    *.C | *.H)
        fileType=source
        ;;
    *)
        if head -c 2 "$file" | grep -q '^#!'
        then
            continue
        elif head -n 20 "$file" | grep -q '^FoamFile'
        then
            fileType=dict
        else
            continue
        fi
        ;;
    esac

    case "$fileType" in
    source) updateSource "$file" > "$tmpFile" ;;
    dict)   updateDict   "$file" > "$tmpFile" ;;
    esac
    status=$?

    # Code fragment with no header
    [ "$status" -eq 3 ] && continue

    nChecked=$((nChecked + 1))

    if [ "$status" -ne 0 ]
    then
        echo "No $fileType header found: $file" 1>&2
        nFailed=$((nFailed + 1))
        continue
    fi

    if ! cmp -s "$file" "$tmpFile"
    then
        nOutdated=$((nOutdated + 1))

        if "$checkOnly"
        then
            echo "Outdated header: $file"
        else
            echo "Updated header: $file"
            # Use cat to keep the permissions and soft-links of the file
            cat "$tmpFile" >| "$file"
        fi
    fi
done

echo "Checked $nChecked files: $nOutdated outdated, $nFailed without a header"

if "$checkOnly" && [ "$nOutdated" -gt 0 ]
then
    echo "Update them with: bin/beamFoamUpdateHeaders <file1> ... <fileN>"
fi

if [ "$nFailed" -gt 0 ] || { "$checkOnly" && [ "$nOutdated" -gt 0 ]; }
then
    exit 1
fi

#------------------------------------------------------------------------------
