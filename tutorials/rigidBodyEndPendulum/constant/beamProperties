FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

beamModel coupledTotalLagNewtonRaphsonBeam;

// Compound pendulum: a body pinned to the tip of a short, stiff rod,
// swinging under gravity. x points down: the rod hangs along +x from its
// clamp at left, and the body hangs from its tip at (0.5 0 0), with its
// centre of mass d = 1 m further down. It swings in the x-y plane. The
// small-angle period is
//     T = 2 pi sqrt((J + m d^2)/(m g d)) = 2.8370 s
// for m = 10 kg, J = 10 kg m^2 and g = 9.81 m/s^2. The rod is stiff
// (bending 3 E I/L^3 = 5.9e4 N/m, axial E A/L = 7.9e6 N/m), so the pin
// hardly moves and the period is that of a pendulum about a fixed pin.
beams
(
    beam_0
    {
        crossSectionModel    circle;

        circleCrossSectionModelDict
        {
            radius    0.05;
        }

        length       0.5;
        nSegments    20;
        E            5e8;
        G            1.923e8;
        rho          1;
    }
);

"coupledTotalLagNewtonRaphsonBeamCoeffs"
{
    // No buoyancy
    rhoFluid rhoFluid [1 -3 0 0 0 0 0] 0;

    startPatchName    left;
    endPatchName      right;

    nCorrectors       200;
    solutionTol       1e-10;
    // Round-off floor of the force residual
    absoluteTol       1e-8;

    debug no;

    // The body and the beam are solved in turn (the only coupling so far)
    rigidBodyCoupling partitioned;

    rigidBodyEnd
    {
        patch               right;

        // The body turns freely about the beam end, which passes only a
        // force: the beam end needs a zero moment Theta condition
        joint               pin;

        mass                10;
        momentOfInertia     (10 10 10);
        centreOfMass        (1.5 0 0);

        // Started hanging straight down, turning at 0.1 rad/s about z: an
        // amplitude of 0.1/omega = 0.045 rad, so the small-angle period
        // holds to 1.3e-4. The centre of mass moves with the turn, so the
        // pin starts at rest: velocity = angularVelocity x (1 0 0)
        velocity            (0 0.1 0);
        angularVelocity     (0 0 0.1);

        // Partitioned coupling: beta dt^2 k/m at the pin is 0.2 along the
        // rod (k = E A/L, m = 10 kg) and 0.003 across it (k = 3 E I/L^3,
        // m = 1/(1/m + d^2/J) = 5 kg), well below 1 (see rigidBodyEnd.H)
        nCouplingIterations 20;
        couplingTolerance   1e-10;
    }
}

