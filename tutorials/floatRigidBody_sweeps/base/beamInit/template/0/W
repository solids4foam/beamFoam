FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      W;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Anchor
    left
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    // Attachment: pulled along the line to pretension it. In the coupled
    // run this becomes fixedValue and the rigid body drives it.
    right
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
        displacementSeries
        {
            file        "$FOAM_CASE/constant/timeVsDisplacement";
            outOfBounds clamp;
        }
    }

    beam
    {
        type            empty;
    }
}

