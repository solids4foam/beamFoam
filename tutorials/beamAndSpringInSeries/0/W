FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      W;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left
    {
        type fixedBeamDisplacement;
        value uniform (0 0 0);

        displacementSeries
        {
            file        "$FOAM_CASE/constant/timeVsDisp";
            outOfBounds     clamp;
        }
    }
    right
    {
        type linearSpringForceBeamDisplacementNR;

        linearSpringCoeffs
        {
            springStiffness 1000;
            springDirection (1 0 0);
        }

        offsetForceSeries
        {
            file    "$FOAM_CASE/constant/timeVsOffsetForce";
            outOfBounds    clamp;
        }

    }
    beam
    {
        type empty;
    }
}


