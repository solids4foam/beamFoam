FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    lowerWall
    {
        // bottom edge: no-slip wall
        type            zeroGradient;
    }

    upperWall
    {
        // top edge: symmetry
        type            symmetry;
    }

    frontAndBack
    {
        //        type            empty;
        type        symmetry;
    }
}


