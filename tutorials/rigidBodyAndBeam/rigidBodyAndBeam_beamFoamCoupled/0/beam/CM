FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       surfaceTensorField;
    location    "2";
    object      CM;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 3 -2 0 0 0 0];

internalField   uniform (0.00120637 0 0 0 0.000603186 0 0 0 0.000603186);

boundaryField
{
    left
    {
        type            calculated;
        value           uniform (0.00120637 0 0 0 0.000603186 0 0 0 0.000603186);
    }
    right
    {
        type            calculated;
        value           uniform (0.00120637 0 0 0 0.000603186 0 0 0 0.000603186);
    }
    beam
    {
        type            empty;
        value           nonuniform List<tensor> 0();
    }
}


