FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        type  totalPressure;
        p0    uniform 0;
    }
    right
    {
        type  totalPressure;
        p0    uniform 0;
    }
    front
    {
        type  totalPressure;
        p0    uniform 0;
    }
    back
    {
        type  totalPressure;
        p0    uniform 0;
    }
    top
    {
        type  totalPressure;
        p0    uniform 0;
    }
    bottom
    {
        type  fixedFluxExtrapolatedPressure;
        value uniform 0;
    }
    floatingObject
    {
        type  fixedFluxExtrapolatedPressure;
        value uniform 0;
    }
}

