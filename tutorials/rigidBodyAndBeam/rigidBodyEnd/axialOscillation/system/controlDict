FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     beamFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.2;

deltaT          0.00025;

writeControl    timeStep;

writeInterval   400;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

functions
{
    // Reaction at the pin
    beamForcesMoments
    {
        type            beamForcesMoments;
        historyPatch    left;
    }

    // Solver work per time step, for comparing monolithic and partitioned
    // coupling (postProcessing/0/beamSolverIterations.dat): evolve calls
    // (1 here), beam Newton loops (> 1 with partitioned coupling
    // iterations), Newton iterations and their running total
    beamSolverIterations
    {
        type            beamSolverIterations;
        libs            ("libwireBunchingModels.so");
    }
}

