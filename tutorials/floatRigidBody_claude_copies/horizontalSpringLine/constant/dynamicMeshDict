FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh       dynamicMotionSolverFvMesh;

motionSolverLibs    ("libfiniteVolumeBeamMooring");

motionSolver        sixDoFRigidBodyMotionFvBeam;

sixDoFRigidBodyMotionFvBeamCoeffs
{
    patches         (floatingObject);

    // Points within innerDistance of the box move rigidly; beyond
    // outerDistance they are fixed
    innerDistance   0.01;
    outerDistance   0.1;

    // Box 0.1 x 0.05 x 0.05 m, half submerged (draft 0.025 m, water at
    // z = 0.15). Buoyancy = 998.2*0.1*0.05*0.025*g = 0.124775 kg * g. The
    // horizontal line is weightless (no constant/beamone/g, as in
    // AssessmentOfCoupledFVFramework) and unpretensioned, so it exerts no
    // force at rest and mass = buoyancy.
    mass            0.124775;
    centreOfMass    (0.5 0.025 0.15);
    orientation     (1 0 0 0 1 0 0 0 1);

    // Solid box: m*(Ly^2 + Lz^2, Lx^2 + Lz^2, Lx^2 + Ly^2)/12
    momentOfInertia (5.1990e-05 1.2997e-04 1.2997e-04);

    report          on;

    accelerationRelaxation 0.4;

    solver
    {
        type FvBeamNewmark;
    }

    // The box spans the tank width: surge, heave and pitch only
    constraints
    {
        xzPlane
        {
            sixDoFRigidBodyMotionFvBeamConstraint plane;
            normal (0 1 0);
        }
        yAxis
        {
            sixDoFRigidBodyMotionFvBeamConstraint axis;
            axis (0 1 0);
        }
    }

    // Single horizontal line from the spring anchor (left) to the box
    // (right): see beamInit
    restraints
    {
        beamone
        {
            sixDoFRigidBodyMotionFvBeamRestraint finiteVolumeBeam;
            attachmentPatch right;
            anchorPatch     left;
            beamRegion      "beamone";
            refAttachmentPt (0.45 0.025 0.125);
        }
    }
}

