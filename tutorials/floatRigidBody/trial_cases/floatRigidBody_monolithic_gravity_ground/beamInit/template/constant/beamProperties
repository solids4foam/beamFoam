FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mooring line template: @L0@, @R@, @NSEG@, @E@, @G@ and @STEADY@ are
// replaced by beamInit/makeBeams

beamModel coupledTotalLagNewtonRaphsonBeam;

nBeams 1;
R R [0 1 0 0 0 0 0] @R@;
L L [0 1 0 0 0 0 0] @L0@;   // Unstretched length
nSegments @NSEG@;

beams
(
    beam_0
    {
        crossSectionModel    circle;
        circleCrossSectionModelDict
        {
            radius    @R@;
        }
        length       @L0@;
        nSegments    @NSEG@;
    }
);

"coupledTotalLagNewtonRaphsonBeamCoeffs"
{
    E E [1 -1 -2 0 0 0 0] @E@;
    G G [1 -1 -2 0 0 0 0] @G@;
    // Submerged density of nylon (1140 - 998.2): the beam model does not
    // apply buoyancy, so the line's weight in water is set here
    rho rho [1 -3 0 0 0 0 0] 141.8;
    rhoFluid rhoFluid [1 -3 0 0 0 0 0] 998.2;   // Lines are submerged

    groundContactActive true;     // Not read: see constant/beamMomentumContributionProperties
    groundZ -0.15;
    gStiffness 1E04;
    gDamping 1.0;

    startPatchName left;    // Anchor
    endPatchName right;     // Attachment to the box

    nCorrectors 200;
    convergenceTol 1e-10;

    debug no;
    updatedLagrangian no;
    objectiveInterpolation false;

    // true during the pretension (beamInit) step, false in the coupled run
    steadyState @STEADY@;
    newmark false;
}

