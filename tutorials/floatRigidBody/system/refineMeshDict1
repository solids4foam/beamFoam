FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      refineMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cells to refine; name of cell set
set c1;

// Coordinate system for refinement
coordinateSystem global;

// Global coordinate system coefficients
globalCoeffs
{
    tan1 (1 0 0);  
    tan2 (0 1 0); 
}

directions
(
    tan1
);

// Hex topology and settings
useHexTopology true;
geometricCut  false;
writeMesh     false;


