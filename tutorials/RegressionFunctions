# File
#     RegressionFunctions
#
# Description
#     Functions for the regressionTest.sh scripts of the tutorials. Source it
#     from a case directory:
#
#         . "${0%/*}/../RegressionFunctions"
#
#     A test runs the case, then checks values against references:
#
#         regression::run "$@"
#         regression::check "Tip w_x" \
#             "$(regression::column postProcessing/0/tip.dat w_x final)" \
#             -10 1e-5
#         regression::finish
#
#     regression::run takes --check-only, to check an existing run without
#     running the case again.
#
#------------------------------------------------------------------------------

regression_failures=0
regression_checks=0

# Run the case with Allrun, unless --check-only is given. Stops the test if
# the solver did not finish
regression::run()
{
    local arg checkOnly=false

    for arg in "$@"
    do
        case "$arg" in
            --check-only) checkOnly=true ;;
        esac
    done

    if [ "$checkOnly" = false ]
    then
        ./Allclean > /dev/null 2>&1
        ./Allrun > log.Allrun 2>&1
    fi

    if [ ! -f log.beamFoam ] || ! tail -n 5 log.beamFoam | grep -q '^End'
    then
        echo "FAIL: beamFoam did not finish (see log.beamFoam)"
        tail -n 15 log.beamFoam 2> /dev/null
        echo "Regression test FAILED"
        exit 1
    fi
}


# Print a value from a column of a postProcessing table:
#     regression::column <file> <columnName> <mode> [time]
# The column is named in the header line, e.g. "Time w_x w_y w_z mag(w)" or
# "# Time nCorrectors nEvolve nNewton". The mode is
#     final               the value in the last row
#     at                  the value at the given time (to 1e-9)
#     max, min, maxabs    over the rows, after the given time if one is given
#     sum                 over the rows, after the given time if one is given
regression::column()
{
    local file="$1" name="$2" mode="$3" time="${4:-}"

    if [ ! -f "$file" ]
    then
        echo "missing"
        return 1
    fi

    awk -v name="$name" -v mode="$mode" -v time="$time" '
        function isNumber(s) { return s ~ /^[-+]?[0-9.]+([eE][-+]?[0-9]+)?$/ }
        function abs(x) { return x < 0 ? -x : x }
        !isNumber($1) {
            # Header line: find the column, ignoring a leading "#"
            offset = ($1 == "#") ? 1 : 0
            for (i = 1 + offset; i <= NF; i++)
            {
                if ($i == name) { col = i - offset }
            }
            next
        }
        col {
            v = $col + 0
            if (mode == "final")
            {
                result = $col
                found = 1
            }
            else if (mode == "at")
            {
                if (!found && abs($1 - time) <= 1e-9)
                {
                    result = $col
                    found = 1
                }
            }
            else if (time == "" || $1 > time + 1e-9)
            {
                if (mode == "max" && (!found || v > result)) result = v
                if (mode == "min" && (!found || v < result)) result = v
                if (mode == "maxabs" && (!found || abs(v) > result))
                {
                    result = abs(v)
                }
                if (mode == "sum") result += v
                found = 1
            }
        }
        END { if (found) print result; else { print "missing"; exit 1 } }
    ' "$file"
}


# Check a value against a reference:
#     regression::check <label> <value> <reference> <relTol> [absTol]
# Passes if |value - reference| <= max(relTol*|reference|, absTol)
regression::check()
{
    local label="$1" value="$2" ref="$3" rtol="$4" atol="${5:-0}"

    regression_checks=$((regression_checks + 1))

    if awk -v v="$value" -v r="$ref" -v rt="$rtol" -v at="$atol" '
        function abs(x) { return x < 0 ? -x : x }
        BEGIN {
            if (v !~ /^[-+]?[0-9.]+([eE][-+]?[0-9]+)?$/) exit 1
            tol = rt*abs(r)
            if (at > tol) tol = at
            exit !(abs(v - r) <= tol)
        }'
    then
        printf "PASS: %s = %s (reference %s)\n" "$label" "$value" "$ref"
    else
        printf "FAIL: %s = %s (reference %s, relTol %s, absTol %s)\n" \
            "$label" "$value" "$ref" "$rtol" "$atol"
        regression_failures=$((regression_failures + 1))
    fi
}


# Check that a value is within [min, max]:
#     regression::checkRange <label> <value> <min> <max>
regression::checkRange()
{
    local label="$1" value="$2" min="$3" max="$4"

    regression_checks=$((regression_checks + 1))

    if awk -v v="$value" -v lo="$min" -v hi="$max" '
        BEGIN {
            if (v !~ /^[-+]?[0-9.]+([eE][-+]?[0-9]+)?$/) exit 1
            exit !(v >= lo && v <= hi)
        }'
    then
        printf "PASS: %s = %s (in [%s, %s])\n" "$label" "$value" "$min" "$max"
    else
        printf "FAIL: %s = %s (not in [%s, %s])\n" \
            "$label" "$value" "$min" "$max"
        regression_failures=$((regression_failures + 1))
    fi
}


# Print the summary and exit: 0 if every check passed, 1 otherwise
regression::finish()
{
    echo
    if [ "$regression_checks" -eq 0 ]
    then
        echo "Regression test FAILED: no checks were run"
        exit 1
    elif [ "$regression_failures" -eq 0 ]
    then
        echo "Regression test PASSED ($regression_checks checks)"
        exit 0
    else
        echo "Regression test FAILED" \
            "($regression_failures of $regression_checks checks)"
        exit 1
    fi
}

