FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Theta;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Clamped: the rod is a cantilever
    left
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    // Welded to the body: set from the body's rotation each solve
    right
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    beam
    {
        type            empty;
    }
}

