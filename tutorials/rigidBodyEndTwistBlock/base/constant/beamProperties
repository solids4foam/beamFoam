FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

beamModel coupledTotalLagNewtonRaphsonBeam;

// Cantilever along +x, clamped at left, with a body welded to the tip.
// Torsional stiffness G Ip/L = 102.57 N m/rad (Ip = pi R^4/2); with the
// body's J = 0.05 kg m^2 the torsional mode is at 45.3 rad/s. For a circular
// rod the static twist under an end torque, M L/(G Ip), holds at any twist.
// makeCases scales G (moment sweep: M)
beams
(
    beam_0
    {
        crossSectionModel    circle;

        circleCrossSectionModelDict
        {
            radius    0.05;
        }

        length       2;
        nSegments    40;
        E            5.4326e7;
        G            2.0895e7;
        rho          1;
    }
);

"coupledTotalLagNewtonRaphsonBeamCoeffs"
{
    // No buoyancy
    rhoFluid rhoFluid [1 -3 0 0 0 0 0] 0;

    startPatchName    left;
    endPatchName      right;

    nCorrectors       200;
    solutionTol       1e-10;
    // Round-off floor of the force residual
    absoluteTol       1e-8;

    debug no;

    rigidBodyCoupling partitioned;

    rigidBodyEnd
    {
        patch               right;

        // The end face turns with the body and passes the beam's end moment
        joint               welded;

        // Centre of mass at the tip (the default): the applied moment
        // reaches the rod only through the welded joint
        mass                1;
        momentOfInertia     (0.05 0.05 0.05);

        // Step moment about the rod axis: static twist M L/(G Ip) = 1 rad.
        // Viscous damping decays the oscillation at c/(2J) = 10 1/s for any
        // stiffness, so every case settles on the static twist
        externalMoment      (102.57 0 0);
        angularDamping      1;

        // Trapezoidal rule: no numerical damping
        newmarkBeta         0.25;
        newmarkGamma        0.5;

        // Partitioned: iterate to convergence
        nCouplingIterations 50;
        couplingTolerance   1e-10;

        // Monolithic only: finite-difference check of the body columns in
        // the first 2 time steps
        jacobianCheck       2;
    }
}

