FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

beamModel coupledTotalLagNewtonRaphsonBeam;

// The rigidBodyEndTwist rod, 2.6565 m long so it reaches the body centre:
// G Ip/L = 77.22 N m/rad; with the body's J = 0.05 kg m^2 the torsional mode
// is at 39.3 rad/s. The body is moorFV's (constant/dynamicMeshDict), so there
// is no rigidBodyEnd here
beams
(
    beam_0
    {
        crossSectionModel    circle;

        circleCrossSectionModelDict
        {
            radius    0.05;
        }

        length       2.6565;
        nSegments    60;
        E            5.4326e7;
        G            2.0895e7;
        rho          1;
    }
);

"coupledTotalLagNewtonRaphsonBeamCoeffs"
{
    // No buoyancy
    rhoFluid rhoFluid [1 -3 0 0 0 0 0] 0;

    startPatchName    left;
    endPatchName      right;

    nCorrectors       200;
    solutionTol       1e-10;
    // Round-off floor of the force residual
    absoluteTol       1e-8;

    debug no;

}

