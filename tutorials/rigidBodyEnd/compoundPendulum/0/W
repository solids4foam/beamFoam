FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      W;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Pinned support
    left
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    // Attached to rigidBodyEnd: value set from the body displacement
    right
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    beam
    {
        type            empty;
    }
}

