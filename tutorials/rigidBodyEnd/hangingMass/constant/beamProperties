FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

beamModel coupledTotalLagNewtonRaphsonBeam;

// Stiff, light rod: EA/L = 3.1416e5 N/m, rod mass 6.3e-3 kg
beams
(
    beam_0
    {
        crossSectionModel    circle;

        circleCrossSectionModelDict
        {
            radius    0.01;
        }

        length       2;
        nSegments    40;
        E            2e9;
        G            7.6923e8;
        rho          10;
    }
);

"coupledTotalLagNewtonRaphsonBeamCoeffs"
{
    // No buoyancy
    rhoFluid rhoFluid [1 -3 0 0 0 0 0] 0;

    startPatchName    left;
    endPatchName      right;

    nCorrectors       200;
    solutionTol       1e-10;
    // Round-off floor of the force residual is about 1e-9 N here
    absoluteTol       1e-8;

    debug no;

    rigidBodyCoupling partitioned;

    rigidBodyEnd
    {
        patch               right;
        mass                10;

        // Numerically damped Newmark so the body settles to equilibrium
        newmarkBeta         0.49;
        newmarkGamma        0.9;

        // Iterate to convergence: one pass per step is unstable here
        nCouplingIterations 50;
        couplingTolerance   1e-10;
    }
}

